Terminals unused in grammar

    AND
    OR


Grammar

    0 $accept: program $end

    1 program: ε
    2        | program stmt

    3 stmt: IDENT '=' expr ';'
    4     | IF '(' boolexpr ')' '{' stmts '}'
    5     | IF '(' boolexpr ')' '{' stmts '}' ELSE '{' stmts '}'
    6     | WHILE '(' boolexpr ')' '{' stmts '}'
    7     | DEF IDENT '(' ')' '{' stmts '}'
    8     | IDENT '(' ')' ';'
    9     | expr ';'
   10     | NEWLINE

   11 stmts: ε
   12      | stmts stmt

   13 boolexpr: expr '>' expr
   14         | expr '<' expr
   15         | expr GE expr
   16         | expr LE expr
   17         | expr EQ expr
   18         | expr NE expr
   19         | expr

   20 expr: INTEGER
   21     | IDENT
   22     | expr '+' expr
   23     | expr '-' expr
   24     | expr '*' expr
   25     | expr '/' expr
   26     | '(' expr ')'
   27     | '-' expr


