Grammar

    0 $accept: program $end

    1 program: ε
    2        | program stmt

    3 stmt: IDENT '=' expr ';'
    4     | INT IDENT '[' INTEGER ']' ';'
    5     | INT IDENT '[' INTEGER ']' '[' INTEGER ']' ';'
    6     | IDENT '[' expr ']' '=' expr ';'
    7     | IDENT '[' expr ']' '[' expr ']' '=' expr ';'
    8     | expr ';'
    9     | NEWLINE

   10 expr: INTEGER
   11     | IDENT '[' expr ']'
   12     | IDENT '[' expr ']' '[' expr ']'
   13     | IDENT
   14     | expr '+' expr
   15     | expr '-' expr
   16     | expr '*' expr
   17     | expr '/' expr
   18     | '(' expr ')'
   19     | '-' expr


