Grammar

    0 $accept: program $end

    1 program: ε
    2        | program stmt

    3 stmt: IDENT '=' expr ';'
    4     | INT IDENT '[' INTEGER ']' ';'
    5     | IDENT '[' expr ']' '=' expr ';'
    6     | expr ';'
    7     | NEWLINE

    8 expr: INTEGER
    9     | IDENT '[' expr ']'
   10     | IDENT
   11     | expr '+' expr
   12     | expr '-' expr
   13     | expr '*' expr
   14     | expr '/' expr
   15     | '(' expr ')'
   16     | '-' expr


