Terminals unused in grammar

    RETURN
    AND
    OR


Grammar

    0 $accept: program $end

    1 program: ε
    2        | program stmt

    3 stmt: IDENT '=' expr ';'
    4     | DEF IDENT '(' param_list ')' '{' stmts '}'
    5     | IDENT '(' arg_list ')' ';'
    6     | IF '(' boolexpr ')' '{' stmts '}'
    7     | IF '(' boolexpr ')' '{' stmts '}' ELSE '{' stmts '}'
    8     | WHILE '(' boolexpr ')' '{' stmts '}'
    9     | expr ';'
   10     | NEWLINE

   11 param_list: IDENT
   12           | param_list ',' IDENT

   13 arg_list: ε
   14         | expr
   15         | arg_list ',' expr

   16 stmts: ε
   17      | stmts stmt

   18 boolexpr: expr '>' expr
   19         | expr '<' expr
   20         | expr GE expr
   21         | expr LE expr
   22         | expr EQ expr
   23         | expr NE expr
   24         | expr

   25 expr: INTEGER
   26     | IDENT
   27     | expr '+' expr
   28     | expr '-' expr
   29     | expr '*' expr
   30     | expr '/' expr
   31     | '(' expr ')'
   32     | '-' expr


